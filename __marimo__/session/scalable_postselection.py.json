      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\"><strong>Phase 2 \u2014 Apparent Gap.</strong> Accept/Reject buttons are now live. Use the\n<strong>Apparent Gap</strong> <marimo-tex class=\"arithmatex\">||(G_A||)</marimo-tex> (computed from the visible syndrome only, assuming a clean\nboundary) to decide. <em>Beware:</em> when the boundary hides errors, <marimo-tex class=\"arithmatex\">||(G_A||)</marimo-tex> can be\ndangerously overconfident. You will experience unexpected logical failures.</span></span>"
          }
        }
